# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false

# ─── PostgreSQL / PostGIS ─────────────────────────────────────────────────────
POSTGRES_USER=geo3d
POSTGRES_PASSWORD=geo3dpass
POSTGRES_DB=geo3d
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://geo3d:geo3dpass@localhost:5432/geo3d

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_PORT=8000

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# ─── Cesium ───────────────────────────────────────────────────────────────────
# Get a free token at https://ion.cesium.com/tokens
# Leave blank to use default Cesium World Terrain (limited)
VITE_CESIUM_TOKEN=

# ─── Data Storage ─────────────────────────────────────────────────────────────
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=2048

# ─── ODM / WebODM (Phase 4 — not required for Phase 1) ──────────────────────
WEBODM_URL=
WEBODM_USERNAME=
WEBODM_PASSWORD=

# ─── AI (Phase 6 — not required for Phase 1) ─────────────────────────────────
AI_ENABLED=false
